<resources xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Base application theme. -->
    <style name="Base.Theme.SocialLed" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="fontFamily">@font/dmsan</item>
        <item name="android:statusBarColor">@color/tertiary</item>
        <item name="android:navigationBarColor">@color/navBar</item>
        <item name="colorControlNormal">@color/white</item>



    </style>

    <style name="Theme.SocialLed" parent="Base.Theme.SocialLed" />

    <style name="bottomNav">
        <item name="itemIconSize">27dp</item>
        <item name="itemTextAppearanceActive">@font/dmsan</item>
        <item name="itemTextAppearanceInactive">@font/dmsan</item>
        <item name="android:itemBackground">@color/transparent</item>
        <item name="itemActiveIndicatorStyle">@color/transparent</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="android:background">@drawable/border_bottomnav</item>
    </style>

    <style name="toolBar">
        <item name="android:background">@drawable/border_toolbar</item>

    </style>

    <style name="cvHome">
        <item name="android:layout_height">110dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="cardBackgroundColor">@color/primarySecond</item>
        <item name="cardCornerRadius">10dp</item>
    </style>


    <style name="ButtonStyle">
        <item name="cardBackgroundColor">@color/tertiarySecond</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>

    </style>

    <style name="textStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/secondarySecond</item>
        <item name="android:layout_gravity">center</item>
    </style>
    
    
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_inset</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.SocialLed</item>

    </style>





</resources>