<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/createSignsFragment">

    <fragment
        android:id="@+id/createSignsFragment"
        android:name="com.sign.led.ui.createSigns.CreateSignsFragment"
        android:label="fragment_create_signs"
        tools:layout="@layout/fragment_create_signs" >
        <action
            android:id="@+id/action_createSignsFragment_to_signFullViewActivity2"
            app:destination="@id/signFullViewActivity"
            />

    </fragment>

    <fragment
        android:id="@+id/mySignsFragment2"
        android:name="com.sign.led.ui.mysigns.MySignsFragment"
        android:label="fragment_my_signs"
        tools:layout="@layout/fragment_my_signs" >
        <action
            android:id="@+id/action_mySignsFragment2_to_signFullViewActivity"
            app:destination="@id/signFullViewActivity" />
    </fragment>
    <fragment
        android:id="@+id/signsFragment2"
        android:name="com.sign.led.ui.signs.SignsFragment"
        android:label="fragment_signs"
        tools:layout="@layout/fragment_signs" >
        <action
            android:id="@+id/action_signsFragment2_to_signFullViewActivity"
            app:destination="@id/signFullViewActivity" />
    </fragment>

    <activity
        android:id="@+id/signFullViewActivity"
        android:name="com.sign.led.ui.signFullView.SignFullViewActivity"
        android:label="activity_sign_full_view"
        tools:layout="@layout/activity_sign_full_view" >
        <argument
            android:name="id"
            app:argType="long"/>
        <argument
            android:name="type"
            app:argType="string" />
    </activity>
</navigation>