<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cuadrito exterior -->
    <item android:drawable="@android:color/transparent"/>

    <!-- Líneas del cuadrito -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:color="#FFFFFF" android:width="1dp"/>
        </shape>
    </item>

    <!-- Esquina inferior derecha del cuadrito -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
        </shape>
    </item>

</layer-list>