<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.mysigns.MySignsFragment"
    android:background="@color/primary">



    <TextView
        android:id="@+id/tvTitleFragmentLedSigns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/led_signs"
        android:textSize="25sp"
        android:textColor="@color/textBehind"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rvLedSigns"
        android:layout_margin="30dp"

        />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLedSigns"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleFragmentLedSigns"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="20dp"
        android:padding="10dp"
        android:background="@drawable/background_my_signs_gradient"

        />


</androidx.constraintlayout.widget.ConstraintLayout>